<script>
window.__SHEET_CSS = "/* Nexus brand. Primary #0099D8, text #504F51, light #EDEDEE, slate #778390, light blue #99D6EF, orange #F18A00, green #93D500.\n   --brand is for fills, rules and focus. --accent is the darker blue used for text and buttons, which keeps contrast above 4.5:1. */\n:root {\n  --paper: #ffffff;\n  --sheet: #ffffff;\n  --wash: #f6f6f7;\n  --ink: #2f2e30;\n  --ink-2: #504f51;\n  --ink-3: #66707b;\n  --rule: #ededee;\n  --rule-2: #c9ccd0;\n  --field: #8b95a0;\n  --brand: #0099d8;\n  --accent: #0079ad;\n  --accent-ink: #ffffff;\n  --accent-soft: #e6f5fc;\n  --sky: #99d6ef;\n  --redline: #b3261e;\n  --redline-soft: #fbe9e7;\n  --ok: #3f6a00;\n  --ok-line: #93d500;\n  --ok-soft: #f1f9dc;\n  --warn: #8a5000;\n  --warn-line: #f18a00;\n  --warn-soft: #fdf1df;\n  --f-body: 'Lato', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;\n  --f-mono: 'Roboto Condensed', 'Arial Narrow', sans-serif;\n  --f-disp: 'Roboto Condensed', 'Arial Narrow', sans-serif;\n}\n\n/* Published minutes. Used on screen and in the exported file, so it only uses the tokens. */\n.sheet { background: var(--sheet); color: var(--ink); border: 1px solid var(--rule-2); font-family: var(--f-body); font-size: 14px; line-height: 1.45; }\n.sheet .muted, .export .muted { color: var(--ink-3); }\n.sheet .od, .export .od { color: var(--redline); font-weight: 600; }\n\n.tb { display: grid; grid-template-columns: repeat(6, 1fr); border-bottom: 1px solid var(--rule-2); }\n.tb-c { display: flex; flex-direction: column; gap: 2px; padding: 8px 12px 9px; border-right: 1px solid var(--rule); border-top: 1px solid var(--rule); grid-column: span 2; min-width: 0; }\n.tb-p { grid-column: span 3; border-top: 0; }\n.tb-s { border-top: 0; }\n.tb-rev { grid-column: span 1; border-top: 0; border-right: 0; background: var(--accent-soft); }\n.tb-c:last-child { border-right: 0; }\n.tb-l { font: 500 10.5px/1.2 var(--f-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--ink-3); }\n.tb-v { font-size: 15px; font-weight: 500; overflow-wrap: anywhere; }\n.tb-rev .tb-v { font: 600 26px/1 var(--f-mono); color: var(--accent); }\n\n.sh-att { padding: 12px 14px 4px; border-bottom: 1px solid var(--rule); }\n.sh-att p { margin: 0 0 8px; }\n.sh-att b { font: 500 10.5px/1.2 var(--f-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--ink-3); margin-right: 8px; }\n.sh-sum { margin: 0; padding: 10px 14px; border-bottom: 1px solid var(--rule); font-size: 13px; color: var(--ink-2); }\n.sh-sum b { font-family: var(--f-mono); color: var(--ink); font-weight: 600; }\n.sh-sum b.od { color: var(--redline); }\n\n.sh-sec h3, .sh-acts h3, .sh-revs h3, .sh-attp h3 { margin: 0; padding: 14px 14px 6px; font: 600 17px/1.2 var(--f-disp); letter-spacing: .06em; text-transform: uppercase; display: flex; align-items: baseline; gap: 10px; }\n.sh-sec h3 { border-top: 1px solid var(--ink); margin-top: 2px; }\n.sh-sec h3 .sn { font: 600 14px/1 var(--f-mono); color: var(--accent); letter-spacing: 0; }\n.tp { display: grid; grid-template-columns: 3rem minmax(0, 1fr); gap: 0 8px; padding: 9px 14px 10px; border-top: 1px solid var(--rule); }\n.sh-sec h3 + .tp { border-top: 0; }\n.tp-no, .a-ref { font: 500 13px/1.5 var(--f-mono); color: var(--ink-3); font-variant-numeric: tabular-nums; }\n.tp-text { font-weight: 600; overflow-wrap: anywhere; }\n.oc { display: grid; grid-template-columns: 1.4rem 6.6rem minmax(0, 1fr); gap: 0 8px; padding-top: 6px; align-items: start; }\n.oc-l { font: 500 12.5px/1.7 var(--f-mono); color: var(--ink-3); }\n.ty { font: 500 10.5px/1.9 var(--f-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--ink-2); }\n.ty-decision { color: var(--accent); }\n.ty-assignment { color: var(--warn); }\n.oc-t { overflow-wrap: anywhere; white-space: pre-wrap; }\n.oc-m { font-size: 13px; color: var(--ink-2); margin-top: 1px; }\n.sh-empty { padding: 12px 14px; margin: 0; }\n\n.sh-acts { border-top: 1px solid var(--ink); margin-top: 2px; }\n.ahead, .arow { display: grid; grid-template-columns: 6rem minmax(0, 1fr) 11rem 5.5rem 5.5rem; gap: 0 12px; padding: 9px 14px; align-items: start; }\n.ahead { padding-block: 4px 6px; font: 500 10px/1.2 var(--f-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--ink-3); }\n.arow { border-top: 1px solid var(--rule); }\n.a-meta { display: contents; }\n.a-text { font-weight: 500; overflow-wrap: anywhere; }\n.a-note { margin-top: 3px; font-size: 13px; color: var(--ink-2); overflow-wrap: anywhere; white-space: pre-wrap; }\n.a-note b { font: 500 10px/1.4 var(--f-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--ink-3); margin-right: 6px; }\n.a-who, .a-due { font-size: 13px; color: var(--ink-2); overflow-wrap: anywhere; font-variant-numeric: tabular-nums; }\n.a-due small { display: block; color: var(--ink-3); font-size: 11.5px; }\n.a-due.od, .a-due.od small { color: var(--redline); font-weight: 600; }\n.a-st { font: 500 11px/1.7 var(--f-mono); letter-spacing: .05em; text-transform: uppercase; color: var(--ink-2); }\n.a-st.st-done { color: var(--ok); }\n.a-st.st-new { color: var(--accent); }\n.a-st.st-extended { color: var(--warn); }\n.a-done .a-text { color: var(--ink-3); }\n\n.sh-revs { padding-bottom: 6px; }\n.rrow { display: grid; grid-template-columns: 4rem 11rem minmax(0, 1fr); gap: 0 12px; padding: 7px 14px; border-top: 1px solid var(--rule); font-size: 13px; }\n.r-n { font: 600 12px/1.6 var(--f-mono); color: var(--accent); }\n.r-d { color: var(--ink-3); font-variant-numeric: tabular-nums; }\n.r-t { overflow-wrap: anywhere; }\n\n.fig { margin: 8px 0 4px; max-width: 100%; }\n.fig-half { max-width: 50%; }\n.fig img, .fig-page img { display: block; max-width: 100%; height: auto; border: 1px solid var(--rule-2); background: #fff; }\n.fig figcaption, .fig-page figcaption { margin-top: 3px; font-size: 12.5px; color: var(--ink-2); overflow-wrap: anywhere; }\n.fig figcaption b, .fp-h b { font: 600 11.5px/1.4 var(--f-mono); color: var(--accent); margin-right: 6px; }\n.seeatt { margin: 6px 0 0; font-size: 13px; color: var(--ink-2); font-style: italic; }\n.fig-miss { padding: 18px; border: 1px dashed var(--rule-2); color: var(--ink-3); font-size: 13px; }\n.sh-attp { border-top: 1px solid var(--ink); margin-top: 2px; }\n.fig-page { margin: 0; padding: 12px 14px 14px; border-top: 1px solid var(--rule); }\n.sh-attp h3 + .fig-page { border-top: 0; }\n.fp-h { display: flex; gap: 12px; align-items: baseline; margin-bottom: 6px; font: 500 12px/1.4 var(--f-mono); color: var(--ink-3); }\n.fig-page img { max-height: 9in; margin-inline: auto; }\n\n@media (max-width: 640px) {\n  .fig-half { max-width: 100%; }\n  .tb { grid-template-columns: repeat(2, 1fr); }\n  .tb-c, .tb-s, .tb-rev { grid-column: span 1; }\n  .tb-p { grid-column: span 2; border-right: 0; }\n  .tb-s { border-top: 1px solid var(--rule); }\n  .tb-rev { border-top: 1px solid var(--rule); }\n  .tb-d { border-right: 0; }\n  .tb-c:last-child { grid-column: span 2; }\n  .tp { grid-template-columns: 2.6rem minmax(0, 1fr); padding-inline: 12px; }\n  .oc { grid-template-columns: 1.2rem minmax(0, 1fr); }\n  .oc .ty { grid-column: 2; }\n  .oc-b { grid-column: 2; }\n  .ahead { display: none; }\n  .arow { grid-template-columns: 4.6rem minmax(0, 1fr); padding-inline: 12px; }\n  .a-meta { display: flex; flex-wrap: wrap; gap: 2px 14px; grid-column: 2; margin-top: 4px; align-items: baseline; }\n  .a-due small { display: inline; margin-left: 6px; }\n  .a-due::before { content: 'Due '; color: var(--ink-3); }\n  .rrow { grid-template-columns: 3.4rem minmax(0, 1fr); }\n  .r-t { grid-column: 2; }\n}\n@media print { .sheet { border: 0; } .arow, .tp, .fig { break-inside: avoid; } .fig-page { break-before: page; page-break-before: always; border-top: 0; } .fig-page img { max-height: 8.6in; } }\n\n.export { background: var(--paper); margin: 0; padding: 24px 16px; font-family: var(--f-body); }\n.export .sheet { max-width: 900px; margin: 0 auto; }\n.ty-carried { color: var(--ink-3); }\n.a-ref small { display: block; font: 400 10.5px/1.3 var(--f-body); color: var(--ink-3); letter-spacing: 0; }\n.oc-m .st-done { color: var(--ok); }\n.oc-m .st-extended { color: var(--warn); }\n.oc-carried.a-done .oc-t { color: var(--ink-3); }\n\nbody{margin:0}\n.sh-brk { margin: 0; padding: 6px 14px; font-size: 13px; font-style: italic; color: var(--ink-3); border-top: 1px solid var(--rule); }\n.sh-brk b { font: 700 10.5px/1 var(--f-mono); letter-spacing: .08em; text-transform: uppercase; font-style: normal; margin-right: 6px; }\n.sh-sec h3 .stime { font: 600 13px/1 var(--f-mono); color: var(--ink-3); letter-spacing: 0; text-transform: none; }\n.sh-none { margin: 4px 0 8px; color: #778390; font-style: italic; }\n";
</script>
