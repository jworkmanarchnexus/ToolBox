{
  "description": "Fee Builder rules that are not a full proposal: reading typed numbers, rounding, contract value, and back-solving. Language-neutral tables: input -> expected output. Rounding follows docs: every calculation runs at full precision; figures are rounded once for presentation, halves round away from zero, and parts are rounded with the largest-remainder method (ties go to the earlier item) so they always add up to the rounded whole.",
  "parse": [
    { "text": "$1,250", "value": 1250 }, { "text": "5%", "value": 5 }, { "text": "15m", "value": 15000000 }, { "text": "250k", "value": 250000 },
    { "text": "(500)", "value": -500, "note": "brackets mean negative" }, { "text": "(1,000)", "value": -1000 }, { "text": "1.5k", "value": 1500 }, { "text": "$2.4m", "value": 2400000 },
    { "text": " 12 ", "value": 12 }, { "text": "", "value": null, "note": "blank stays blank, never zero" }, { "text": "abc", "value": null }, { "text": "1.2.3", "value": null }, { "text": "--5", "value": null }
  ],
  "roundTo": [
    { "value": 1234.5, "increment": 1, "expect": 1235 }, { "value": 1234, "increment": 100, "expect": 1200 }, { "value": 1250, "increment": 100, "expect": 1300 },
    { "value": 1249.99, "increment": 10, "expect": 1250 }, { "value": -1250, "increment": 100, "expect": -1300 }
  ],
  "largestRemainder": [
    { "values": [33.33, 33.33, 33.34], "increment": 1, "total": 100, "expect": [33, 33, 34] },
    { "values": [10.5, 10.5, 10.5, 10.5], "increment": 1, "total": 42, "expect": [11, 11, 10, 10], "note": "a tie goes to the earlier item" },
    { "values": [1000.4, 2000.4, 3000.4], "increment": 100, "total": 6000, "expect": [1000, 2000, 3000] },
    { "values": [0.3333333333333333, 0.3333333333333333, 0.3333333333333333], "increment": 0.01, "total": 1, "expect": [0.34, 0.33, 0.33] }
  ],
  "contract": [
    {
      "name": "Accepted additional scopes count, proposed ones are pending, rejected ones never count",
      "originalContractValue": 500000,
      "changes": [{ "label": "Lobby", "amount": 20000, "status": "accepted" }, { "label": "Signage", "amount": 15000, "status": "rejected" }, { "label": "Renderings", "amount": 40000, "status": "proposed" }],
      "expect": { "original": 500000, "accepted": 20000, "pending": 40000, "current": 520000, "ifAccepted": 560000 }
    }
  ],
  "solve": [
    { "name": "What fee percent gives a $900,000 client fee? (the proposal itself is not changed)", "build": { "proposal": { "cost": 15000000, "method": "pctCost", "value": 5 } }, "target": "clientFee", "to": 900000, "byChanging": "fee percent", "expect": { "ok": true, "value": 6, "originalFeePercentUnchanged": 5 } },
    { "name": "What client fee leaves $350,000 of net revenue, with a $180,000 included consultant?", "build": { "proposal": { "cost": 10000000, "method": "pctCost", "value": 6 }, "consultants": [{ "name": "Civil", "type": "fixed", "value": 180000, "treatment": "included" }] }, "target": "netRevenue", "to": 350000, "byChanging": "fee percent", "expect": { "ok": true, "clientFee": 530000, "tolerance": 0.01 } },
    { "name": "If the client will only pay $500,000, what revenue is left?", "build": { "proposal": { "cost": 10000000, "method": "pctCost", "value": 6 }, "consultants": [{ "name": "Civil", "type": "fixed", "value": 180000, "treatment": "included" }] }, "target": "clientFee", "to": 500000, "byChanging": "fee percent", "expect": { "ok": true, "netRevenue": 320000, "tolerance": 0.01 } },
    { "name": "Changing something that does not affect the target is reported, not guessed", "build": { "proposal": { "cost": 10000000, "method": "pctCost", "value": 6 }, "consultants": [{ "name": "Civil", "type": "fixed", "value": 50000, "treatment": "included" }] }, "target": "clientFee", "to": 700000, "byChanging": "the first consultant", "expect": { "ok": false, "reasonContains": "does not affect" } }
  ]
}
